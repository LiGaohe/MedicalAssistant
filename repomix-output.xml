                </div>
                <div id="coverageList" class="coverage-list"></div>
            </div>
            
            <div class="tab-content" id="qualityTab" style="display: none;">
                <h3>文档质量评分</h3>
                <div id="qualityScores" class="quality-scores"></div>
                <div class="quality-assessment">
                    <strong>整体评价：</strong>
