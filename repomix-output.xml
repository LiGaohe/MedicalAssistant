            <button id="evaluateEMR" class="btn-info" style="display: none;">质量评估</button>
            <button id="backToResult" class="btn-secondary">返回转写结果</button>
        </div>
        
        <div class="loading" id="loadingSection" style="display: none;">
            <p>正在生成病历，请稍候...</p>
            <div class="progress-bar">
                <div class="progress-fill" id="progressFill"></div>
            </div>
        </div>
        
        <div id="debugModal" class="modal" style="display: none;">
            <div class="modal-content modal-large">
                <div class="modal-header">
                    <h2>调试模式 - 手动输入大模型结果</h2>
                    <span class="close" id="closeDebugModal">&times;</span>
                </div>
                <div class="modal-body">
                    <div id="debugStages">
                        <div class="debug-stage-selector">
                            <label>选择阶段：</label>
                            <select id="stageSelect"></select>
                        </div>
                        <div class="debug-prompt">
                            <h4>提示词：</h4>
                            <pre id="promptContent"></pre>
                        </div>
                        <div class="debug-instructions">
                            <h4>指导步骤：</h4>
                            <pre id="instructionsContent"></pre>
                        </div>
                        <div class="debug-input">
                            <h4>请输入大模型返回结果：</h4>
                            <textarea id="userResponse" rows="15" placeholder="请输入JSON格式的返回结果..."></textarea>
                        </div>
                        <div class="debug-actions">
                            <button id="submitStage" class="btn-primary">提交并继续</button>
                            <button id="skipStage" class="btn-secondary">跳过此阶段</button>
                        </div>
                    </div>
                    <div id="debugResult" style="display: none;">
                        <h4>处理结果：</h4>
                        <pre id="resultContent"></pre>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="emr-section" id="emrSection" style="display: none;">
            <h2>病历内容</h2>
            <div class="emr-toolbar">
                <div class="emr-version">
                    <label>版本：</label>
                    <select id="versionSelect"></select>
                </div>
                <div class="emr-actions">
                    <button id="editEMR" class="btn-warning">编辑病历</button>
                    <button id="saveEMR" class="btn-success" style="display: none;">保存修改</button>
                    <button id="cancelEdit" class="btn-secondary" style="display: none;">取消编辑</button>
                    <button id="printEMR" class="btn-primary">打印病历</button>
                    <button id="toggleEvidence" class="btn-secondary">显示证据溯源</button>
