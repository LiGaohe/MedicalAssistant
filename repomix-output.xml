<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>病历质量评估 - 中文门诊病历生成系统</title>
    <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
    <div class="container">
        <h1>病历质量评估</h1>
        
        <div class="info-section">
            <p><strong>病历记录:</strong> <span id="recordId"></span></p>
            <p><strong>就诊记录:</strong> <span id="visitId"></span></p>
        </div>
        
        <div class="actions">
            <button id="runEvaluation" class="btn-primary">开始评估</button>
            <button id="debugEvaluation" class="btn-warning">调试模式</button>
            <button id="backToEMR" class="btn-secondary">返回病历</button>
        </div>
        
        <div class="loading" id="loadingSection" style="display: none;">
            <p>正在进行评估，请稍候...</p>
            <div class="progress-bar">
                <div class="progress-fill" id="progressFill"></div>
            </div>
        </div>
        
        <div id="debugModal" class="modal" style="display: none;">
            <div class="modal-content modal-large">
                <div class="modal-header">
                    <h2>调试模式 - 手动输入评估结果</h2>
                    <span class="close" id="closeDebugModal">&times;</span>
                </div>
                <div class="modal-body">
                    <div id="debugStages">
                        <div class="debug-stage-selector">
                            <label>选择阶段：</label>
                            <select id="stageSelect"></select>
                        </div>
                        <div class="debug-prompt">
                            <h4>提示词：</h4>
                            <pre id="promptContent"></pre>
                        </div>
                        <div class="debug-input">
                            <h4>请输入大模型返回结果：</h4>
                            <textarea id="userResponse" rows="15" placeholder="请输入JSON格式的返回结果..."></textarea>
                        </div>
                        <div class="debug-actions">
                            <button id="submitStage" class="btn-primary">提交并继续</button>
                            <button id="skipStage" class="btn-secondary">跳过此阶段</button>
                        </div>
                    </div>
                    <div id="debugResult" style="display: none;">
                        <h4>处理结果：</h4>
                        <pre id="resultContent"></pre>
                    </div>
                </div>
            </div>
        </div>
        
        <div id="evaluationSection" style="display: none;">
            <div class="evaluation-summary">
                <h2>评估概览</h2>
                <div class="score-overview">
                    <div class="score-main">
                        <div class="score-circle" id="overallScoreCircle">
                            <span class="score-value" id="overallScore">--</span>
                            <span class="score-label">综合得分</span>
                        </div>
                    </div>
                    <div class="score-details">
                        <div class="score-item">
                            <span class="score-name">一致性</span>
                            <div class="score-bar">
